# Copy this file to ".env" and fill in the real values.
# The real ".env" is git-ignored and must NEVER be committed.

# ------------------------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------------------------
# Format: https://<project-id>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key (safe for client-side use with RLS enabled)
SUPABASE_ANON_KEY=

# Secret / service_role key — BACKEND ONLY, bypasses RLS. Keep private.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret (Supabase → Project Settings → API → JWT Secret).
# Required when SUPABASE_JWT_ALGORITHM is HS256.
SUPABASE_JWT_SECRET=
# HS256 for the classic shared secret; RS256/ES256 for asymmetric (JWKS) projects.
SUPABASE_JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# Use the Transaction pooler string (port 6543) and the postgresql+asyncpg:// prefix.
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=postgresql://postgres.ziojazjvsjtzcqdckajq:[FutureVision404@]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgresko

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------------------------
PROJECT_NAME=Technify VisionAI
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# FUTURE / OPTIONAL — fill in as these integrations are built
# ------------------------------------------------------------------------------
REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_KEY=
EDGE_AI_GATEWAY_URL=
